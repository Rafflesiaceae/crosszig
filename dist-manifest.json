            },
            "runpath": [],
            "interpreter": "/lib/ld-linux-aarch64.so.1",
            "min-kernel": "2.0.0"
        },
        "crosszig-osx-universal": {
            "platform": "osx-universal",
            "format": "macho-universal",
            "arch": [
                "arm64",
                "x86-64"
            ],
            "slices": {
                "arm64": {
                    "format": "macho",
                    "arch": "arm64",
                    "needs": [
                        "/usr/lib/libSystem.B.dylib"
