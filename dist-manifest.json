{
    "cpu": "baseline",
    "targets": {
        "linux-64": {
            "system": "Linux",
            "processor": "x86_64",
            "triple": "x86_64-linux-gnu.2.3.3"
        },
        "osx-64": {
            "system": "Darwin",
            "processor": "x86_64",
            "triple": "x86_64-macos.11.0-none"
        },
        "osx-arm64": {
            "system": "Darwin",
            "processor": "arm64",
            "triple": "aarch64-macos.11.0-none"
        },
        "win-64": {
            "system": "Windows",
            "processor": "AMD64",
            "triple": "x86_64-windows-gnu",
            "link-flags": "-lucrtbase"
        },
        "win-64-msvc": {
            "system": "Windows",
            "processor": "AMD64",
            "triple": "x86_64-windows-msvc",
            "sdk": "xwin",
            "cxx-standard": 14,
            "cxx-driver": "cc",
            "compile-flags": "-Wno-unused-command-line-argument"
        }
    },
    "files": {
        "crosszig-linux-64": {
            "platform": "linux-64",
            "format": "elf",
            "arch": "x86-64",
            "needs": [
                "ld-linux-x86-64.so.2",
                "libc.so.6",
                "libdl.so.2",
                "libm.so.6",
                "libpthread.so.0",
                "libresolv.so.2",
                "librt.so.1",
                "libutil.so.1"
            ],
            "symbol-versions": {
                "GLIBC": "2.3.3"
            },
            "runpath": [],
            "min-kernel": "2.0.0"
        },
        "crosszig-osx-64": {
            "platform": "osx-64",
            "format": "macho",
            "arch": "x86-64",
            "needs": [
                "/usr/lib/libSystem.B.dylib"
            ],
            "dylib-compat": {
                "/usr/lib/libSystem.B.dylib": "1.0.0"
            },
            "rpath": [],
            "code-signature": false,
            "macos-min": "11.0.0"
        },
        "crosszig-osx-arm64": {
            "platform": "osx-arm64",
            "format": "macho",
            "arch": "arm64",
            "needs": [
                "/usr/lib/libSystem.B.dylib"
            ],
            "dylib-compat": {
                "/usr/lib/libSystem.B.dylib": "1.0.0"
            },
            "rpath": [],
            "code-signature": true,
            "macos-min": "11.0.0"
        },
        "crosszig-win-64-msvc.exe": {
            "platform": "win-64-msvc",
            "format": "pe",
            "arch": "x86-64",
            "needs": [
                "KERNEL32.dll",
                "USER32.dll"
            ],
            "min-os": "6.0",
            "subsystem-version": "6.0"
        },
        "crosszig-win-64-msvc.lib": {
            "platform": "win-64-msvc",
            "format": "archive",
            "arch": "x86-64"
        },
        "crosszig-win-64.exe": {
            "platform": "win-64",
            "format": "pe",
            "arch": "x86-64",
            "needs": [
                "KERNEL32.dll",
                "ucrtbase.dll"
            ],
            "min-os": "6.0",
            "subsystem-version": "6.0"
        },
        "libcrosszig-linux-64.a": {
            "platform": "linux-64",
            "format": "archive",
            "arch": "x86-64"
        },
        "libcrosszig-osx-64.a": {
            "platform": "osx-64",
            "format": "archive",
            "arch": "x86-64"
        },
        "libcrosszig-osx-arm64.a": {
            "platform": "osx-arm64",
            "format": "archive",
            "arch": "arm64"
        },
        "libcrosszig-win-64.a": {
            "platform": "win-64",
            "format": "archive",
            "arch": "x86-64"
        }
    }
}
