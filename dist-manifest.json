{
    "cpu": "baseline",
    "targets": {
        "linux-32": {
            "system": "Linux",
            "processor": "i686",
            "triple": "x86-linux-gnu.2.3.3"
        },
        "linux-64": {
            "system": "Linux",
            "processor": "x86_64",
            "triple": "x86_64-linux-gnu.2.3.3"
        },
        "linux-aarch64": {
            "system": "Linux",
            "processor": "aarch64",
            "triple": "aarch64-linux-gnu.2.17"
        },
        "osx-64": {
            "system": "Darwin",
            "processor": "x86_64",
            "triple": "x86_64-macos.10.12-none"
        },
        "osx-arm64": {
            "system": "Darwin",
            "processor": "arm64",
            "triple": "aarch64-macos.11.0-none"
        },
        "win-32-msvc": {
            "system": "Windows",
            "processor": "x86",
            "triple": "x86-windows-msvc",
            "sdk": "xwin",
            "cxx-standard": 14,
            "cxx-driver": "cc",
            "compile-flags": "-Wno-unused-command-line-argument"
        },
        "win-64-msvc": {
            "system": "Windows",
            "processor": "AMD64",
            "triple": "x86_64-windows-msvc",
            "sdk": "xwin",
            "cxx-standard": 14,
            "cxx-driver": "cc",
            "compile-flags": "-Wno-unused-command-line-argument"
        }
    },
    "universal": {
        "osx-universal": [
            "osx-64",
            "osx-arm64"
        ]
    },
    "files": {
        "crosszig-linux-32": {
            "platform": "linux-32",
            "format": "elf",
            "arch": "x86",
            "needs": [
                "ld-linux.so.2",
                "libc.so.6",
                "libdl.so.2",
                "libm.so.6",
                "libpthread.so.0",
                "libresolv.so.2",
                "librt.so.1",
                "libutil.so.1"
            ],
            "symbol-versions": {
                "GLIBC": "2.3.2"
            },
            "runpath": [],
            "interpreter": "/lib/ld-linux.so.2",
            "min-kernel": "2.0.0"
        },
        "crosszig-linux-64": {
            "platform": "linux-64",
            "format": "elf",
            "arch": "x86-64",
            "needs": [
                "ld-linux-x86-64.so.2",
                "libc.so.6",
